{
  "_comment": "Module manifest for the portal. Every module is ON unless config/portal.json sets modules.switches.<id> to false, or the build env NEXT_PUBLIC_DISABLED_MODULES lists it (comma separated). A module that is off: its home-page links and tiles are hidden and its pages and API routes answer 404. Turning a module off also turns off modules that depend on it. Paths not listed here are never blocked.",
  "modules": [
    {
      "id": "core",
      "label": "Core (home page and shared services)",
      "required": true,
      "routes": [
        "/"
      ],
      "apiRoutes": [
        "/api/lms",
        "/api/spellcheck",
        "/api/closeout",
        "/api/field-data"
      ],
      "note": "Always on. The shared APIs here back sign-in and SafeSubmit for every form, so they are never switched off."
    },
    {
      "id": "lms",
      "label": "Online Training Portal (LMS)",
      "routes": [
        "/lms",
        "/admin"
      ],
      "note": "Pages only. /api/lms stays in core because sign-in and admin tools share it."
    },
    {
      "id": "lms-competency",
      "label": "LMS competency programs",
      "dependencies": [
        "lms"
      ],
      "routes": [
        "/lms/competency"
